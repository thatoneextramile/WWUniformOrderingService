generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model Admin {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      AdminRole @default(STAFF)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  changeRequestsReviewed OrderChangeRequest[]
  @@map("admins")
}

model Parent {
  id                 String   @id @default(cuid())
  firstName          String
  lastName           String
  email              String   @unique
  phone              String
  password           String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  mustChangePassword Boolean  @default(false)
  children           Child[]
  orders             Order[]

  @@map("parents")
}

model Child {
  id        String   @id @default(cuid())
  parentId  String
  class     String?
  createdAt DateTime @default(now())
  firstName String   @default("")
  lastName  String   @default("")
  parent    Parent   @relation(fields: [parentId], references: [id])
}

model Product {
  id           String      @id @default(cuid())
  name         String
  description  String?
  imageUrl     String?
  imageEmoji   String?     @default("👕")
  category     String?
  sellingPrice Decimal     @db.Decimal(10, 2)
  costPrice    Decimal     @db.Decimal(10, 2)
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  imageBg      String?     @default("#e8f7f0")
  imageUrls    String[]    @default([])
  inventory    Inventory[]
  orderItems   OrderItem[]

  @@map("products")
}

model Inventory {
  id          String   @id @default(cuid())
  productId   String
  size        Size
  totalQty    Int      @default(0)
  reservedQty Int      @default(0)
  updatedAt   DateTime @updatedAt
  soldQty     Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@map("inventory")
}

model Location {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@map("locations")
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  parentId       String
  parentName     String
  parentPhone    String
  childName      String
  childClass     String
  locationId     String
  notes          String?
  extraFields    Json?
  subtotal       Decimal     @db.Decimal(10, 2)
  discountRate   Decimal     @db.Decimal(5, 4)
  discountAmount Decimal     @db.Decimal(10, 2)
  totalAmount    Decimal     @db.Decimal(10, 2)
  status         OrderStatus @default(SUBMITTED)
  statusHistory  Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  childId        String?
  items          OrderItem[]
  location       Location    @relation(fields: [locationId], references: [id])
  parent         Parent      @relation(fields: [parentId], references: [id])
  changeRequests OrderChangeRequest[]

  @@index([status])
  @@index([parentId])
  @@index([locationId])
  @@map("orders")
}

model OrderChangeRequest {
  id            String              @id @default(cuid())
  orderId       String
  status        ChangeRequestStatus @default(PENDING)
  changes       Json                // [{ productId, productName, fromSize, toSize }]
  requestedAt   DateTime            @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  rejectionNote String?
  order         Order               @relation(fields: [orderId], references: [id])
  reviewedBy    Admin?              @relation(fields: [reviewedById], references: [id])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  size        Size
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model SiteSettings {
  id                  String   @id @default("singleton")
  systemName          String   @default("Wonderworld Uniforms")
  logoUrl             String?
  logoEmoji           String?  @default("🎒")
  welcomeTitle        String   @default("Welcome to Wonderworld! 🌈")
  welcomeText         String?
  orderInstructions   String?
  noticeText          String?
  discountThreshold   Decimal  @default(500) @db.Decimal(10, 2)
  discountRate        Decimal  @default(0.15) @db.Decimal(5, 4)
  updatedAt           DateTime @updatedAt
  adminEmails         String?
  orderStockThreshold Int      @default(0)

  @@map("site_settings")
}

model FormField {
  id         String    @id @default(cuid())
  label      String
  fieldKey   String    @unique
  fieldType  FieldType @default(text)
  isRequired Boolean   @default(true)
  isVisible  Boolean   @default(true)
  isSystem   Boolean   @default(false)
  sortOrder  Int       @default(0)
  options    Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("form_fields")
}

enum OrderStatus {
  SUBMITTED
  REVIEW
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
  PAID
}

enum Size {
  T1
  T2
  T3
  T4
  T5
  T6
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  STAFF
}

enum FieldType {
  text
  textarea
  select
  phone
  email
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
